#include <stdio.h>

int main() {
    char str[100];
    int i;

    printf("Enter expression: ");
    scanf("%s", str);

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] == '+' || str[i] == '-' ||
            str[i] == '*' || str[i] == '/')
            printf("%c is an operator\n", str[i]);
    }

    return 0;
}

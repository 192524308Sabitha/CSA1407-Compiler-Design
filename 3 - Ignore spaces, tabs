#include <stdio.h>

int main() {
    char ch;

    while ((ch = getchar()) != EOF) {
        if (ch == ' ' || ch == '\t' || ch == '\n')
            continue;

        if (ch == '#') {          // Comment starts with #
            while ((ch = getchar()) != '\n' && ch != EOF);
            continue;
        }

        printf("%c", ch);
    }

    return 0;
}

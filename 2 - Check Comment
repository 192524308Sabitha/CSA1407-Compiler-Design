#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];

    printf("Enter a line: ");
    fgets(str, sizeof(str), stdin);

    if ((str[0] == '/' && str[1] == '/') ||
        (str[0] == '/' && str[1] == '*'))
    {
        printf("It is a Comment.\n");
    }
    else
    {
        printf("It is Not a Comment.\n");
    }

    return 0;
}
